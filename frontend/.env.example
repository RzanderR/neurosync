# Copy this file to .env.local and fill in the URLs from your AWS deploy.
# When VITE_USE_MOCKS=true OR any URL is missing, the frontend uses bundled mock data.

VITE_USE_MOCKS=true

# Lambda Function URL for the schedule (triage) endpoint.
# e.g. https://abc123.lambda-url.us-west-2.on.aws/
VITE_SCHEDULE_URL=

# Lambda Function URL for the message-rewrite endpoint.
VITE_REWRITE_URL=

# Public S3 object URL for providers.json (the file the frontend reads to populate the
# "Find a Provider" tab). Must allow public read or be CORS-friendly to the frontend origin.
# e.g. https://neurosync-providers.s3.us-west-2.amazonaws.com/providers.json
VITE_PROVIDERS_S3_URL=
