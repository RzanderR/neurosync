# Copy this file to .env.local and fill in the URLs from your AWS deploy.
# When VITE_USE_MOCKS=true OR any URL is missing, the frontend uses bundled mock data.

VITE_USE_MOCKS=true

# Lambda Function URL for the patient-registration endpoint.
# Writes the patient JSON to s3://<bucket>/patients/{patientId}.json and returns { patientId }.
VITE_REGISTER_URL=

# Lambda Function URL for the provider-recommendation endpoint.
# Invokes Bedrock with the two hardcoded provider profiles + the patient's request
# and returns { providerId, reasoning }.
VITE_RECOMMEND_URL=

# Lambda Function URL for the schedule (triage) endpoint.
# For the demo, this returns a canned response per clinicId (no Bedrock).
VITE_SCHEDULE_URL=

# Lambda Function URL for the message-rewrite endpoint.
# For the demo, rewrites are hardcoded client-side; this endpoint is optional.
VITE_REWRITE_URL=
